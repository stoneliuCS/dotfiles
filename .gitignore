scripts/.local/bin/songs/
scripts/.local/bin/downloaded.txt
scripts/.local/bin/__pycache__/

# Claude Code writes runtime/synced state into ~/.claude/skills - never
# version-control that, only Stone's own hand-authored skills/commands.
claude/.claude/skills/synced/
claude/.claude/skills/.trash/

# Salesforce skills stay private and this repo is public.
# Real files live in salesforce-skills/; skills/ holds a symlink per skill.
# Anything Salesforce-specific goes in salesforce-skills/, never skills/.
claude/.claude/salesforce-skills/
claude/.claude/skills/trailhead-study
claude/.claude/skills/pi-ask

# Salesforce tooling build/cache output. The Apex language server writes its
# .sfdx/ (StandardApexLibrary stubs, indexes) into whatever it resolves as the
# workspace - outside an sfdx project that's a literal "null/" dir.
.sfdx/
.sf/
nvim/.config/nvim/null/
